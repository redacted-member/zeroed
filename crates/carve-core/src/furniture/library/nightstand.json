{
  "format": 1,
  "id": "nightstand",
  "name": "Nightstand",
  "category": "Beds",
  "description": "Bedside table with a drawer on slides, an open shelf below and an overhanging top.",
  "license": "CC0-1.0",
  "author": "CarveStudio contributors",
  "source": null,
  "credit": null,
  "tags": ["bedroom", "bedside", "drawer", "table"],
  "params": [
    { "key": "width", "label": "Width", "kind": "length", "default": 450, "min": 350, "max": 600, "group": "Size" },
    { "key": "height", "label": "Height", "kind": "length", "default": 600, "min": 450, "max": 750, "group": "Size" },
    { "key": "depth", "label": "Carcass depth", "kind": "length", "default": 380, "min": 300, "max": 500, "group": "Size" },
    { "key": "t", "label": "Panel thickness", "kind": "thickness", "default": 18, "min": 15, "max": 25, "group": "Material" },
    { "key": "drawer_h", "label": "Drawer opening", "kind": "length", "default": 150, "min": 100, "max": 250, "group": "Layout" },
    { "key": "oh", "label": "Top overhang", "kind": "length", "default": 20, "min": 0, "max": 40, "group": "Layout" },
    { "key": "shelf", "label": "Shelf", "kind": "toggle", "default": 1, "group": "Layout" },
    { "key": "kick", "label": "Toe kick", "kind": "toggle", "default": 1, "group": "Layout" },
    { "key": "back", "label": "Back", "kind": "toggle", "default": 1, "group": "Layout" }
  ],
  "derived": {
    "kh": "{kick}*80",
    "inner_w": "{width}-2*{t}",
    "body_d": "{depth}-{back}*6",
    "zd": "{height}-2*{t}-{drawer_h}",
    "box_x": "{t}+12.7",
    "box_w": "{inner_w}-25.4",
    "box_d": "{body_d}-20",
    "box_h": "{drawer_h}-25",
    "box_z": "{zd}+{t}+8"
  },
  "materials": {
    "main": { "label": "Carcass", "thickness": "{t}" },
    "drawer": { "label": "Drawer box", "thickness": "12" },
    "back": { "label": "Back and drawer bottom", "thickness": "6" }
  },
  "panels": [
    { "id": "left", "name": "Left side", "material": "main", "grain": "long",
      "box": { "x": "0", "y": "0", "z": "0", "w": "{t}", "d": "{depth}", "h": "{height}-{t}" },
      "features": [ { "kind": "notch", "edge": "bottom", "at": "front", "w": "50", "h": "{kh}", "when": "{kick}" } ] },
    { "id": "right", "name": "Right side", "material": "main", "grain": "long",
      "box": { "x": "{width}-{t}", "y": "0", "z": "0", "w": "{t}", "d": "{depth}", "h": "{height}-{t}" },
      "features": [ { "kind": "notch", "edge": "bottom", "at": "front", "w": "50", "h": "{kh}", "when": "{kick}" } ] },
    { "id": "top", "name": "Top", "material": "main", "grain": "long",
      "box": { "x": "-{oh}", "y": "-{t}-{oh}", "z": "{height}-{t}", "w": "{width}+2*{oh}", "d": "{depth}+{t}+{oh}", "h": "{t}" },
      "features": [ { "kind": "radius", "r": "6" } ] },
    { "id": "divider", "name": "Drawer floor", "material": "main", "grain": "long",
      "box": { "x": "{t}", "y": "0", "z": "{zd}", "w": "{inner_w}", "d": "{body_d}", "h": "{t}" } },
    { "id": "bottom", "name": "Bottom", "material": "main", "grain": "long",
      "box": { "x": "{t}", "y": "0", "z": "{kh}", "w": "{inner_w}", "d": "{body_d}", "h": "{t}" } },
    { "id": "shelf", "name": "Shelf", "material": "main", "grain": "long", "when": "{shelf}",
      "box": { "x": "{t}", "y": "0", "z": "{kh}+{t}+({zd}-{kh}-2*{t})/2", "w": "{inner_w}", "d": "{body_d}", "h": "{t}" } },
    { "id": "kick", "name": "Toe kick", "material": "main", "grain": "long", "when": "{kick}",
      "box": { "x": "{t}", "y": "50", "z": "0", "w": "{inner_w}", "d": "{t}", "h": "{kh}" } },
    { "id": "back", "name": "Back", "material": "back", "grain": "long", "when": "{back}",
      "box": { "x": "{t}", "y": "{depth}-6", "z": "{kh}", "w": "{inner_w}", "d": "6", "h": "{height}-{t}-{kh}" } },
    { "id": "front", "name": "Drawer front", "material": "main", "grain": "long",
      "box": { "x": "2", "y": "-{t}", "z": "{zd}+2", "w": "{width}-4", "d": "{t}", "h": "{drawer_h}+{t}-4" } },
    { "id": "box_l", "name": "Drawer left side", "material": "drawer", "grain": "long",
      "box": { "x": "{box_x}", "y": "0", "z": "{box_z}", "w": "12", "d": "{box_d}", "h": "{box_h}" },
      "features": [ { "kind": "slideHoles", "at": "{box_h}/2" } ] },
    { "id": "box_r", "name": "Drawer right side", "material": "drawer", "grain": "long",
      "box": { "x": "{box_x}+{box_w}-12", "y": "0", "z": "{box_z}", "w": "12", "d": "{box_d}", "h": "{box_h}" },
      "features": [ { "kind": "slideHoles", "at": "{box_h}/2" } ] },
    { "id": "box_f", "name": "Drawer box front", "material": "drawer", "grain": "long",
      "box": { "x": "{box_x}+12", "y": "0", "z": "{box_z}", "w": "{box_w}-24", "d": "12", "h": "{box_h}" } },
    { "id": "box_b", "name": "Drawer box back", "material": "drawer", "grain": "long",
      "box": { "x": "{box_x}+12", "y": "{box_d}-12", "z": "{box_z}", "w": "{box_w}-24", "d": "12", "h": "{box_h}" } },
    { "id": "box_bottom", "name": "Drawer bottom", "material": "back", "grain": "none",
      "box": { "x": "{box_x}+12", "y": "12", "z": "{box_z}+10", "w": "{box_w}-24", "d": "{box_d}-24", "h": "6" } }
  ],
  "connections": [
    { "a": "front", "b": "*", "class": "front" },
    { "a": "box_bottom", "b": "*", "class": "drawer_bottom" },
    { "a": "box_f|box_b", "b": "box_l|box_r", "class": "drawer" },
    { "a": "back", "b": "top", "class": "back_top" },
    { "a": "top", "b": "*", "class": "top" },
    { "a": "divider|bottom|shelf", "b": "left|right", "class": "carcass" },
    { "a": "kick", "b": "bottom", "class": "kick_bottom" },
    { "a": "kick", "b": "*", "class": "kick" },
    { "a": "back", "b": "*", "class": "back" }
  ],
  "jointClasses": {
    "top": { "label": "Top to sides", "default": "dowel" },
    "carcass": { "label": "Bottom, drawer floor and shelf", "default": "dado" },
    "kick": { "label": "Toe kick", "default": "dowel" },
    "kick_bottom": { "label": "Toe kick to bottom", "default": "tabSlot" },
    "back_top": { "label": "Back to top", "default": "none" },
    "back": { "label": "Back", "default": "rabbet" },
    "drawer": { "label": "Drawer box corners", "default": "finger" },
    "drawer_bottom": { "label": "Drawer bottom", "default": "groove" },
    "front": { "label": "False front", "default": "none" }
  },
  "hardware": [
    { "name": "Full extension drawer slides, pair", "count": "1", "note": "length to suit the drawer box depth" },
    { "name": "Drawer pull", "count": "1" },
    { "name": "Screws 4 x 25 mm", "count": "4", "note": "false front to drawer box, from inside" }
  ]
}
