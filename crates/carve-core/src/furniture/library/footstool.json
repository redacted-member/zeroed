{
  "format": 1,
  "id": "footstool",
  "name": "Footstool",
  "category": "Seating",
  "description": "Mission footstool: a thick top with a hand hold on two arched leg boards joined by a center brace.",
  "license": "PD",
  "author": "H. H. Windsor (Popular Mechanics Co.), adapted by CarveStudio contributors",
  "source": "https://www.gutenberg.org/ebooks/23991",
  "credit": "After \"An Oak Footstool\", Mission Furniture: How to Make It, Part II, H. H. Windsor, 1910 (public domain)",
  "tags": ["mission", "stool", "foot rest", "hand hold", "small project"],
  "params": [
    { "key": "length", "label": "Length", "kind": "length", "default": 305, "min": 250, "max": 500, "group": "Size" },
    { "key": "width", "label": "Width", "kind": "length", "default": 241, "min": 200, "max": 350, "group": "Size" },
    { "key": "height", "label": "Height", "kind": "length", "default": 330, "min": 200, "max": 450, "group": "Size" },
    { "key": "t", "label": "Leg thickness", "kind": "thickness", "default": 19, "min": 15, "max": 22, "group": "Material" },
    { "key": "tt", "label": "Top thickness", "kind": "thickness", "default": 25, "min": 19, "max": 32, "group": "Material" },
    { "key": "handhold", "label": "Hand hold in the top", "kind": "toggle", "default": 1, "group": "Style" }
  ],
  "derived": {
    "leg_h": "{height}-{tt}",
    "span": "{length}-76",
    "lw": "{width}-38"
  },
  "materials": {
    "main": { "label": "Legs and brace", "thickness": "{t}" },
    "top": { "label": "Top", "thickness": "{tt}" }
  },
  "panels": [
    { "id": "top", "name": "Top", "material": "top", "grain": "long",
      "box": { "x": "0", "y": "0", "z": "{leg_h}", "w": "{length}", "d": "{width}", "h": "{tt}" },
      "features": [
        { "kind": "radius", "r": "10" },
        { "kind": "handle", "u": "{length}/2", "v": "{width}/2", "w": "100", "h": "30", "when": "{handhold}" }
      ] },
    { "id": "leg_l", "name": "Left leg", "material": "main", "grain": "long",
      "box": { "x": "38-{t}", "y": "19", "z": "0", "w": "{t}", "d": "{lw}", "h": "{leg_h}" },
      "features": [ { "kind": "arch", "edge": "bottom", "rise": "{leg_h}/5", "inset": "25" } ] },
    { "id": "leg_r", "name": "Right leg", "material": "main", "grain": "long",
      "box": { "x": "{length}-38", "y": "19", "z": "0", "w": "{t}", "d": "{lw}", "h": "{leg_h}" },
      "features": [ { "kind": "arch", "edge": "bottom", "rise": "{leg_h}/5", "inset": "25" } ] },
    { "id": "brace", "name": "Brace", "material": "main", "grain": "long",
      "box": { "x": "38", "y": "{width}/2-{t}/2", "z": "50", "w": "{span}", "d": "{t}", "h": "{leg_h}-120" } }
  ],
  "connections": [
    { "a": "top", "b": "leg_l|leg_r", "class": "top" },
    { "a": "brace", "b": "leg_l|leg_r", "class": "brace" }
  ],
  "jointClasses": {
    "top": { "label": "Top to legs", "default": "dowel" },
    "brace": { "label": "Brace to legs", "default": "wedgedTenon" }
  },
  "hardware": [
    { "name": "Wood screws 45 mm", "count": "8", "note": "the 1910 stool is screwed together; use them with the dowels or alone with butt joints" },
    { "name": "Felt pads", "count": "4" }
  ]
}
