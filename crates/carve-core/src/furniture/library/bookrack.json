{
  "format": 1,
  "id": "bookrack",
  "name": "Bookrack",
  "category": "Decor",
  "description": "Mission tabletop bookrack: two slotted ends joined by two long stretchers that lap through them and carry the books.",
  "license": "PD",
  "author": "H. H. Windsor (Popular Mechanics Co.), adapted by CarveStudio contributors",
  "source": "https://www.gutenberg.org/ebooks/23666",
  "credit": "After \"A Mission Bookrack\", Mission Furniture: How to Make It, Part III, H. H. Windsor, 1912 (public domain)",
  "tags": ["mission", "books", "desk", "book ends", "cross lap", "scrap"],
  "params": [
    { "key": "length", "label": "Length", "kind": "length", "default": 508, "min": 350, "max": 900, "group": "Size" },
    { "key": "depth", "label": "Depth", "kind": "length", "default": 178, "min": 140, "max": 260, "group": "Size" },
    { "key": "height", "label": "End height", "kind": "length", "default": 190, "min": 150, "max": 300, "group": "Size" },
    { "key": "t", "label": "Panel thickness", "kind": "thickness", "default": 19, "min": 15, "max": 22, "group": "Material" },
    { "key": "ext", "label": "Stretcher overhang past the ends", "kind": "length", "default": 25, "min": 10, "max": 60, "group": "Style" }
  ],
  "derived": {
    "g": "({depth}-50)/5",
    "slot_v": "({height}+25)/2",
    "slot_h": "{height}-75"
  },
  "materials": {
    "main": { "label": "Boards", "thickness": "{t}" }
  },
  "panels": [
    { "id": "end_l", "name": "Left end", "material": "main", "grain": "long",
      "box": { "x": "{ext}", "y": "0", "z": "0", "w": "{t}", "d": "{depth}", "h": "{height}" },
      "features": [
        { "kind": "cutout", "u": "25+1.5*{g}", "v": "{slot_v}", "w": "{g}", "h": "{slot_h}", "r": "3" },
        { "kind": "cutout", "u": "25+3.5*{g}", "v": "{slot_v}", "w": "{g}", "h": "{slot_h}", "r": "3" }
      ] },
    { "id": "end_r", "name": "Right end", "material": "main", "grain": "long",
      "box": { "x": "{length}-{ext}-{t}", "y": "0", "z": "0", "w": "{t}", "d": "{depth}", "h": "{height}" },
      "features": [
        { "kind": "cutout", "u": "25+1.5*{g}", "v": "{slot_v}", "w": "{g}", "h": "{slot_h}", "r": "3" },
        { "kind": "cutout", "u": "25+3.5*{g}", "v": "{slot_v}", "w": "{g}", "h": "{slot_h}", "r": "3" }
      ] },
    { "id": "str_f", "name": "Front stretcher", "material": "main", "grain": "long",
      "box": { "x": "0", "y": "25", "z": "0", "w": "{length}", "d": "{t}", "h": "25" } },
    { "id": "str_b", "name": "Back stretcher", "material": "main", "grain": "long",
      "box": { "x": "0", "y": "{depth}-25-{t}", "z": "0", "w": "{length}", "d": "{t}", "h": "25" } }
  ],
  "connections": [
    { "a": "str_f|str_b", "b": "end_l|end_r", "class": "lap" }
  ],
  "jointClasses": {
    "lap": { "label": "Stretchers through ends", "default": "crossLap" }
  },
  "hardware": [
    { "name": "Rubber bumpers", "count": "4", "note": "under the stretcher ends so the rack does not mar the desk" }
  ]
}
