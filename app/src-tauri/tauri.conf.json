{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeroed",
  "version": "../package.json",
  "identifier": "com.zeroed.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zeroed",
        "backgroundColor": "#15171a",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "GraphicsAndDesign",
    "shortDescription": "CNC design and toolpath studio",
    "fileAssociations": [
      {
        "ext": ["carve"],
        "name": "Zeroed Job",
        "description": "Zeroed job",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zeroed.job",
          "conformsTo": ["public.data", "public.content"]
        }
      },
      {
        "ext": ["carveclip"],
        "name": "Zeroed Clipart",
        "description": "Zeroed clipart",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zeroed.clipart",
          "conformsTo": ["public.data", "public.content"]
        }
      },
      {
        "ext": ["cstemplate"],
        "name": "Zeroed Toolpath Template",
        "description": "Zeroed toolpath template",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.zeroed.template",
          "conformsTo": ["public.data", "public.content"]
        }
      },
      {
        "ext": ["dxf", "dwg", "eps", "ai", "stl", "obj", "3ds", "3dm"],
        "name": "Design File",
        "description": "Vectors and 3D models Zeroed can import",
        "role": "Viewer"
      },
      {
        "ext": ["svg"],
        "name": "SVG Image",
        "description": "Vectors Zeroed can import",
        "role": "Viewer"
      },
      {
        "ext": ["pdf", "png", "jpg", "jpeg", "bmp", "gif", "tif", "tiff", "webp"],
        "name": "Image or PDF",
        "description": "Bitmaps to trace and PDF vectors Zeroed can import",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 the Zeroed authors",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/carve-document.icns": "icons/carve-document.icns",
        "Resources/carveclip-document.icns": "icons/carveclip-document.icns"
      },
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
